# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# MONGODB_URI: MongoDB Atlas connection string (optional in dev, falls back to persistent local storage)
MONGODB_URI="mongodb+srv://<username>:<password>@cluster.mongodb.net/remly?retryWrites=true&w=majority"

# ELEVENLABS_API_KEY: ElevenLabs API Key for realistic AI Tutor speech synthesis
ELEVENLABS_API_KEY="your_elevenlabs_api_key_here"

# SESSION_SECRET: Secret key for signing JWT tokens and sessions
SESSION_SECRET="remly-super-secure-session-secret-key-2026"

# EMAIL CREDENTIALS: Optional SMTP/Email provider settings for automated class reminders & OTP
EMAIL_PROVIDER_USER="notifications@remly.edu"
EMAIL_PROVIDER_PASS="your_email_smtp_password"

